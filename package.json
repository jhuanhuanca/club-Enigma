{
  "name": "karaoke",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:promo": "vite --config promo/vite.config.ts",
    "build": "vue-tsc -b && vite build",
    "build:promo": "vue-tsc -p promo/tsconfig.app.json && vite build --config promo/vite.config.ts",
    "preview": "vite preview",
    "preview:promo": "vite preview --config promo/vite.config.ts"
  },
  "dependencies": {
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
